{% set total_rows = (events|length + 1) // 2 %}
{% set header_height = 260 %}
{% set row_height = 160 %}
{% set card_height = 140 %}
{% set footer_margin = 20 %}
{% set footer_height = 90 %}
{% set footer_y = header_height + (total_rows * row_height) + footer_margin %}
{% set svg_height = footer_y + footer_height + 40 %}
{% if svg_height < 1350 %}
  {% set svg_height = 1350 %}
{% endif %}

<svg width="1080" height="{{ svg_height }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1080 {{ svg_height }}">
  <!-- Background -->
  <rect width="100%" height="100%" fill="#1B323D" />

  <!-- Header -->
  <!-- MakeIt Labs Logo -->
  <image x="40" y="40" width="300" height="150" href="{{ url_for('static', filename='MakeIt Labs Logo 2016.svg', _external=True) }}" />
  
  <text x="360" y="90" fill="white" font-size="64" font-family="sans-serif" font-weight="bold">This week at</text>
  <text x="360" y="160" fill="white" font-size="72" font-family="sans-serif" font-weight="bold">{{ date_range }}</text>
  
  <text x="540" y="230" fill="white" font-size="28" font-family="sans-serif" font-weight="bold" text-anchor="middle">Events are for MakeIt Labs members only unless otherwise noted</text>

  <!-- Events -->
  {% for e in events %}
    {% set row = loop.index0 // 2 %}
    {% set col = loop.index0 % 2 %}
    {% set x = 30 + col * 520 %}
    {% set y = header_height + row * row_height %}
    
    <g class="event-card">
      <!-- Orange border -->
      <rect x="{{ x }}" y="{{ y }}" width="500" height="{{ card_height }}" rx="20" fill="none" stroke="#E67E50" stroke-width="4" />
      
      <!-- Date Box (White background, orange text) -->
      <path d="M {{ x+20 }} {{ y }} L {{ x+110 }} {{ y }} L {{ x+110 }} {{ y+card_height }} L {{ x+20 }} {{ y+card_height }} A 20 20 0 0 1 {{ x }} {{ y+card_height-20 }} L {{ x }} {{ y+20 }} A 20 20 0 0 1 {{ x+20 }} {{ y }} Z" fill="white" />
      <text x="{{ x+55 }}" y="{{ y+40 }}" fill="#E67E50" font-size="28" font-family="sans-serif" font-weight="bold" text-anchor="middle">{{ e.date_abbr }}</text>
      <text x="{{ x+55 }}" y="{{ y+95 }}" fill="#E67E50" font-size="56" font-family="sans-serif" font-weight="bold" text-anchor="middle">{{ e.date_day }}</text>
      <text x="{{ x+55 }}" y="{{ y+125 }}" fill="#E67E50" font-size="24" font-family="sans-serif" font-weight="bold" text-anchor="middle">{{ e.date_month }}</text>
      
      <!-- Details Box -->
      {% if e.title2 %}
        <text x="{{ x+130 }}" y="{{ y+45 }}" fill="white" font-size="26" font-family="sans-serif" font-weight="bold">{{ e.title1 }}</text>
        <text x="{{ x+130 }}" y="{{ y+75 }}" fill="white" font-size="26" font-family="sans-serif" font-weight="bold">{{ e.title2 }}</text>
        <text x="{{ x+130 }}" y="{{ y+115 }}" fill="#88D1D1" font-size="24" font-family="sans-serif" font-weight="bold">{{ e.time }}</text>
      {% else %}
        <text x="{{ x+130 }}" y="{{ y+60 }}" fill="white" font-size="26" font-family="sans-serif" font-weight="bold">{{ e.title1 }}</text>
        <text x="{{ x+130 }}" y="{{ y+105 }}" fill="#88D1D1" font-size="24" font-family="sans-serif" font-weight="bold">{{ e.time }}</text>
      {% endif %}
    </g>
  {% endfor %}

  <!-- Footer -->
  <rect x="40" y="{{ footer_y }}" width="1000" height="{{ footer_height }}" rx="45" fill="#E67E50" />
  <text x="540" y="{{ footer_y + 62 }}" fill="white" font-size="52" font-family="sans-serif" font-weight="bold" text-anchor="middle">makeitlabs.com/events</text>
</svg>
